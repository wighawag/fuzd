{
  "name": "fuzd-server",
  "version": "0.11.0",
  "description": "fuzd server app",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@hono/swagger-ui": "^0.5.0",
    "@scure/bip32": "^1.6.0",
    "@scure/bip39": "^1.5.0",
    "@standard-schema/spec": "^1.0.0",
    "eip-1193": "^0.6.1",
    "eip-1193-jsonrpc-provider": "^0.4.2",
    "eip-1193-signer": "^0.1.0",
    "fuzd-chain-protocol": "workspace:*",
    "fuzd-common": "workspace:*",
    "fuzd-executor": "workspace:*",
    "fuzd-scheduler": "workspace:*",
    "fuzd-tlock-decrypter": "workspace:*",
    "hono": "^4.11.2",
    "hono-openapi": "^1.5.0",
    "named-logs": "^0.3.2",
    "remote-account": "^0.2.2",
    "remote-sql": "^0.0.6",
    "tlock-js": "^0.9.0",
    "viem": "^2.21.55",
    "zod": "^4.4.3",
    "zod-schema-for": "^0.1.1"
  },
  "devDependencies": {
    "@libsql/client": "^0.14.0",
    "as-soon": "^0.0.11",
    "ldenv": "^0.3.12",
    "prettier": "^3.4.2",
    "remote-sql-libsql": "^0.0.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "openapi": "node ./dist/esm/generate-openapi.js ./doc/openapi.json",
    "build:ts": "tsc --project tsconfig.json",
    "build": "pnpm sql2ts && pnpm build:ts && pnpm openapi && cp doc/openapi.json ../../docs/public/",
    "sql2ts": "node sql2ts.cjs executor scheduler",
    "sql2ts:watch": "pnpm sql2ts && as-soon -w ./src/schema/sql pnpm sql2ts",
    "css2ts": "node css2ts.cjs global",
    "css2ts:watch": "pnpm css2ts && as-soon -w ./src/schema/css pnpm css2ts",
    "dev": "as-soon -w src pnpm build:ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run"
  }
}
