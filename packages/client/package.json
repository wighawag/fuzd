{
  "name": "@fuzd/client",
  "version": "0.12.0",
  "description": "default client for fuzd using tlock-js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wighawag/fuzd.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    }
  },
  "bin": {
    "fuzd-client": "dist/esm/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "@fuzd/chain-protocol": "workspace:*",
    "@fuzd/common": "workspace:*",
    "@fuzd/executor": "workspace:*",
    "@fuzd/scheduler": "workspace:*",
    "ldenv": "^0.3.12",
    "named-logs": "^0.3.2",
    "remote-account": "^0.2.2",
    "tlock-js": "^0.9.0",
    "viem": "^2.21.55"
  },
  "devDependencies": {
    "@fuzd/server": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@noble/curves": "1.6.0",
    "@noble/hashes": "1.5.0",
    "@types/node": "^22.10.2",
    "as-soon": "^0.0.11",
    "eip-1193": "^0.6.1",
    "prettier": "^3.4.2",
    "remote-sql-libsql": "^0.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "as-soon -w src pnpm build",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "tsx": "tsx",
    "test": "vitest run"
  }
}
