{
  "name": "fuzd",
  "version": "0.12.0",
  "description": "run fuzd-server as a node process: the fuzd CLI",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "fuzd": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    ".env.default"
  ],
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@libsql/client": "^0.18.0",
    "commander": "^12.1.0",
    "@fuzd/server": "workspace:*",
    "ldenv": "^0.3.12",
    "named-logs-context": "^0.1.1",
    "remote-sql-libsql": "^0.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "as-soon": "^0.0.11",
    "prettier": "^3.4.2",
    "set-defaults": "^0.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "prepare": "set-defaults .env.default",
    "dev": "tsx watch src/cli.ts --port 30042",
    "build": "tsc",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wighawag/fuzd.git",
    "directory": "platforms/nodejs"
  }
}
